# Copy to .env and fill in. .env is gitignored.

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# --- Optional: uncomment to override a default from src/interview_app/config.py ----------------
# Values are validated at startup: a misspelled nested key or an out-of-range number stops the app
# with a clear error. Nested groups use a double underscore.

# Judge runs per feedback report (1 to 5; default from docs/rubric.json). 1 is the cheapest.
# JUDGE_RUNS=1

# Model for a role (models, limits, guard and features all work the same way).
# MODELS__INTERVIEWER=openai/gpt-5-nano
# LIMITS__MAX_TURNS=40
# Range of the "main questions" slider on the start form and Settings page (inside 2-15).
# LIMITS__MIN_MAIN_QUESTIONS=3
# LIMITS__MAX_MAIN_QUESTIONS=12

# Voice channel (text-to-speech). The model must pass this account's OpenRouter guardrail. Voices map per
# interview type (a JSON object); a fixed voice for every interviewer can also be picked on the Settings page.
# TTS__MODEL=google/gemini-3.8-flash-lite-tts
# TTS__VOICES='{"hiring_manager": "Puck"}'
# Audio tokens per second used for the TTS cost ESTIMATE (the speech response reports no usage).
# TTS__AUDIO_TOKENS_PER_SECOND=32

# Docker only (read by compose.yaml, ignored by the app): the uid/gid that owns ./data on the host,
# if `id -u` / `id -g` don't print 1000. See docs/06-docker.md.
# APP_UID=1000
# APP_GID=1000
