# --- Privacy: never commit personal or third-party material -------------------
# Real job applications (CVs, cover letters, JDs) stay local as example cases.
docs/applications/
# Third-party design screenshots used only as local inspiration.
references/app_design/
# Runtime data: SQLite DB, uploaded documents, audio, generated avatars.
data/
# Secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml

# --- Tooling -----------------------------------------------------------------
.worktrees/
.venv/
__pycache__/
*.py[oc]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
.ipynb_checkpoints/
.DS_Store
.idea/
.vscode/

# --- Prompt lab: the per-session CSVs are committed. They hold only metrics (scores, counts, cost)
# from the fictional sample application, no transcript text. While they were ignored, the first
# runs' CSVs were never kept. Anything else a run might drop there stays local.
lab/results/*
!lab/results/.gitkeep
!lab/results/*.csv
